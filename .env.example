# ============================================================================
# EstatePilot AI - 环境变量样例
# 复制为 .env 后按需填写。切勿把真实密钥提交到版本库。
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------
NODE_ENV=development
# 后端 API 端口（前端与 Nginx 都指向它）
API_PORT=3001
# 前端 Web 端口
WEB_PORT=3000
# 对外访问地址（用于生成客户专属链接，必须是客户能打开的地址）
APP_BASE_URL=http://localhost:3000
# 后端对外地址
API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# 数据库（PostgreSQL 18 + pgvector）
# 本机 Docker 容器映射到 5432
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://estatepilot:estatepilot_dev_pwd@localhost:5432/estatepilot?schema=public
POSTGRES_USER=estatepilot
POSTGRES_PASSWORD=estatepilot_dev_pwd
POSTGRES_DB=estatepilot
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis（BullMQ 队列 + 缓存）
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# 认证与安全
# 生产环境务必替换为高强度随机值： openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_dev_only_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=CHANGE_ME_dev_only_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# 用于行为事件 ipHash 脱敏（避免明文存 IP）
IP_HASH_SALT=CHANGE_ME_dev_only_ip_hash_salt
# 允许的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# 限流
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# 客户端行为上报接口单独限额（客户页面公开接口，需要更严）
BEHAVIOR_RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# AI Provider（不写死任何厂商，通过适配器切换）
# 可选值：mock | deepseek | openai | anthropic
# 开发环境默认 mock：无需任何密钥即可完整跑通 AI 流程
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# 用于向量化的模型（pgvector 语义匹配）
AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_DIMENSIONS=1536

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# 对象存储（S3 兼容；阿里云 OSS 亦兼容 S3 协议）
# 留空则使用本地磁盘存储（开发默认）
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=cn-hangzhou
S3_BUCKET=estatepilot
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# 阿里云 OSS 示例：
#   S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#   S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# 房源数据 Provider
# MOCK     - 内置模拟数据（Demo 用，界面会标注 Demo Data）
# BEIKE    - 贝壳 AI 开放平台（真实房源，需 BEIKE_MCP_API_KEY）
# INTERNAL - 中介公司自有房源库（Excel/粘贴导入）
# ---------------------------------------------------------------------------
PROPERTY_PROVIDER=MOCK
PROPERTY_SYNC_CRON=0 */6 * * *
PROPERTY_SYNC_ENABLED=true

# ---------------------------------------------------------------------------
# 贝壳 AI 开放平台（真实房源数据）
# ---------------------------------------------------------------------------
# 接入方式：官方 CLI（本地 MCP 客户端）
#   1. 安装 CLI：pwsh -File infrastructure/beike/install-cli.ps1
#   2. 获取 API Key：infrastructure/beike/bin/beike.exe login
#   3. 把 Key 填到下方 BEIKE_MCP_API_KEY
#
# 安全提示：
#   - 该 Key 通过子进程环境变量注入，不会出现在命令行参数或磁盘配置文件中
#   - 系统日志与接口响应中的 Key 一律脱敏
#   - 若 Key 曾经出现在聊天记录、截图或代码里，请立即在平台重置
BEIKE_MCP_API_KEY=

# CLI 可执行文件路径。留空则使用 infrastructure/beike/bin/beike.exe
BEIKE_CLI_PATH=

# MCP 服务地址（一般无需修改）
BEIKE_MCP_BASE_URL=https://building.ke.com/mcp

# 传输通道：http（直连 MCP）/ cli（本地 CLI 子进程）/ auto（HTTP 优先，失败回退 CLI）
# 留空即 auto
BEIKE_TRANSPORT=auto

# ---- 调用配额保护（贝壳不公开配额，且限流可能持续 1 小时以上）----
# 每小时调用上限。达到后主动停止实时查询并降级到本地缓存，避免触发限流
BEIKE_HOURLY_LIMIT=12
# 每日调用上限
BEIKE_DAILY_LIMIT=40

# 是否在客户匹配时自动调用贝壳检索真实房源
BEIKE_AUTO_SEARCH_ENABLED=true

# ---------------------------------------------------------------------------
# 队列与调度
# ---------------------------------------------------------------------------
QUEUE_PREFIX=estatepilot
QUEUE_CONCURRENCY=5
# 离线/单机开发时可关闭队列，改为进程内直接执行
QUEUE_ENABLED=true

# ---------------------------------------------------------------------------
# 日志
# 级别：fatal | error | warn | info | debug | trace
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
LOG_DIR=./logs

# ---------------------------------------------------------------------------
# 计费 / 套餐（商业化预留）
# ---------------------------------------------------------------------------
DEFAULT_PLAN=FREE
AI_USAGE_MONTHLY_LIMIT_FREE=200
AI_USAGE_MONTHLY_LIMIT_PRO=5000
AI_USAGE_MONTHLY_LIMIT_STORE=20000
AI_USAGE_MONTHLY_LIMIT_ENTERPRISE=200000
