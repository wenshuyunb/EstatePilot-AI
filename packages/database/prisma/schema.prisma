// ============================================================================
// Phase 11 — 微信复制 → AI 需求 → 贝壳 → 推荐闭环
// ============================================================================
//
// 产品边界（重要）：
//   本阶段使用**普通个人微信**，没有聊天 API。
//   因此只做「人工复制 → 系统粘贴 → 系统生成 → 人工发送」。
//   严禁开发微信 Hook、DLL 注入、PC 微信逆向、模拟协议、读取微信数据库。
//   因此这里的「消息导入」只是**处理用户主动粘贴进来的文本**，不是微信 API。
// ============================================================================

/// 消息导入来源。目前只支持人工粘贴，未来可扩展短信/邮件等。
enum MessageImportSource {
  /// 经纪人从普通微信手动复制粘贴（当前唯一实现）
  WECHAT_MANUAL_PASTE
  /// 电话记录（人工整理）
  PHONE_NOTE
  /// 短信
  SMS
  /// 邮件
  EMAIL
  /// 其他
  OTHER
}

/// 消息内容类型
enum MessageImportType {
  /// 客户发来的消息（需求表达）
  CUSTOMER_MESSAGE
  /// 客户对已推荐房源的反馈
  PROPERTY_FEEDBACK
  /// 经纪人自己的记录
  AGENT_NOTE
}

/// 解析状态。失败也必须保留原文，绝不丢数据。
enum MessageParseStatus {
  PENDING
  PARSING
  SUCCESS
  /// 部分字段解析成功
  PARTIAL
  FAILED
}

/// 客户对单套房源的反馈倾向
enum PropertyFeedbackSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  UNKNOWN
}

/// 反馈涉及的具体维度（用于累积"客户为什么喜欢/不喜欢"）
enum FeedbackReactionType {
  PRICE
  LOCATION
  LAYOUT
  COMMUNITY
  FLOOR
  ORIENTATION
  DECORATION
  SCHOOL
  SUBWAY
  AGE
  OTHER
}

/// 推荐批次状态。
/// 注意：普通微信没有发送 API，系统无法知道客户是否收到，
/// 因此只有 COPIED（已复制）与 SENT_CONFIRMED（人工确认已发送）两种，
/// 绝不能自动记为 SENT。
enum RecommendationStatus {
  GENERATED
  COPIED
  SENT_CONFIRMED
  DISCARDED
}

/// 微信回复文案风格
enum ReplyStyle {
  /// 自然专业（默认）
  NATURAL_PROFESSIONAL
  /// 简短
  CONCISE
  /// 详细
  DETAILED
}

/// 粘贴导入的客户消息。
/// 原始文本必须完整保存 —— 即使 AI 解析失败，也绝不能让数据丢失。
model CustomerMessageImport {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agentId        String

  /// 原始文本（完整保留，不截断）
  rawText String @db.Text
  /// 来源渠道
  source MessageImportSource @default(WECHAT_MANUAL_PASTE)
  /// 内容类型
  sourceType MessageImportType @default(CUSTOMER_MESSAGE)

  /// 解析状态
  parseStatus MessageParseStatus @default(PENDING)
  /// AI 解析出的结构化需求（JSON，符合 RequirementExtraction）
  parsedRequirements Json?
  /// 解析错误信息（失败时记录，供排查）
  parseError String?
  /// 解析所用模型与耗时
  parseModel   String?
  parseDurationMs Int?

  /// 由该消息生成的快照（若有变化）
  snapshotId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([customerId, createdAt])
  @@index([customerId, sourceType])
  @@index([parseStatus])
  @@map("customer_message_imports")
}

/// 客户显性需求画像（结构化、可累加）。
///
/// 核心设计：**三级预算模型**。
/// 客户的需求是逐步透露的，不能互相覆盖：
///   第一次"预算 500 万"        → target=500
///   第二次"550 也可以"         → target 仍 500，normalMax=550
///   第三次"特别好的 600 也能考虑" → stretchMax=600
/// 这样需求只会越来越完整，而不会因为最后一句就丢掉前面的信息。
model CustomerRequirementProfile {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String @unique
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // ---- 城市与区域 ----
  city String?
  /// 区域（如 浦东新区）
  districts String[] @default([])
  /// 板块（如 张江）
  subDistricts String[] @default([])
  /// 具体小区
  communities String[] @default([])

  // ---- 三级预算（单位：元）----
  /// 理想预算：客户最舒服的价格
  budgetTarget Int?
  /// 常规上限：可以接受到这个数
  budgetNormalMax Int?
  /// 极限上限：特别满意才会考虑
  budgetStretchMax Int?
  /// 严格上限：客户明确说"超过不看"时为 true，硬筛必须过滤
  budgetStrictMax Boolean @default(false)
  /// 预算下限
  budgetMin Int?

  // ---- 户型 ----
  /// 期望卧室数（可多个）
  bedrooms Int[] @default([])
  /// 户型是否为硬性要求（客户说"只要三房"时为 true）
  bedroomsStrict Boolean @default(false)
  livingRooms Int?

  // ---- 面积 ----
  areaMin Int?
  areaMax Int?

  // ---- 房龄 ----
  /// NEWER / WITHIN_5 / WITHIN_10 / WITHIN_20 / ANY
  buildingAgePreference String?
  /// 明确排除老小区
  avoidOldCommunity Boolean @default(false)

  // ---- 各维度优先级（HIGH / MEDIUM / LOW / UNKNOWN）----
  communityQualityPriority String?
  subwayPriority           String?
  schoolPriority           String?
  decorationPriority       String?
  floorPreference          String?
  orientationPreference    String?
  /// 明确不要一楼/顶楼
  avoidFirstFloor Boolean @default(false)
  avoidTopFloor   Boolean @default(false)
  /// 必须电梯
  requireElevator Boolean @default(false)

  // ---- 装修 ----
  /// ROUGH / SIMPLE / FINE / LUXURY / ANY
  decorationPreference String?
  /// 必须精装
  requireFineDecoration Boolean @default(false)

  // ---- 学区 ----
  /// 学区要求是否明确
  schoolRequired Boolean @default(false)
  schoolNotNeeded Boolean @default(false)
  schoolNote String?

  // ---- 交通 ----
  /// 可接受的最远地铁步行米数
  subwayDistanceMax Int?
  /// 通勤地点
  commuteLocations Json @default("[]")
  /// 是否重视开车便利
  carConvenience Boolean @default(false)

  // ---- 购房意图 ----
  purchasePurpose String?
  paymentMethod   String?
  purchaseTimeline String?
  /// 决策参与者（SELF / SPOUSE / PARENTS / CHILD）
  decisionMakers String[] @default([])
  /// 家庭成员特殊关注点（如"老婆在意小区环境"）
  familyConcerns Json @default("[]")

  // ---- 其它 ----
  /// 其它无法归类的补充要求
  otherRequirements String[] @default([])
  /// 整体置信度 0～1
  confidence Decimal @default(0) @db.Decimal(4, 3)
  /// 已完成的需求来源消息数
  sourceMessageCount Int @default(0)
  /// 最后一次更新来源消息
  lastMessageId String?
  /// 最后更新时间
  lastUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([budgetNormalMax])
  @@index([city, districts])
  @@map("customer_requirement_profiles")
}

/// 需求版本快照。用于回答"客户需求是怎么一步步变化的"。
model CustomerRequirementSnapshot {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// 版本号，从 1 递增
  version Int
  /// 产生该版本的来源消息
  sourceMessageId String?

  /// 完整结构化需求快照（JSON）
  structuredRequirements Json
  /// 本次变化的字段名列表
  changedFields String[] @default([])
  /// 变化前的值（JSON，仅含变化字段）
  previousValues Json?
  /// 变化后的值（JSON，仅含变化字段）
  newValues Json?
  /// 本次变化的置信度 0～1
  confidence Decimal @default(0.8) @db.Decimal(4, 3)
  /// 人类可读的变化摘要（用于界面展示"AI 识别到以下变化"）
  changeSummary Json @default("[]")
  /// 是否包含覆盖型变更（客户明确改口，如"现在只要三房"）
  hasOverride Boolean @default(false)
  /// 是否有待人工确认的低置信度变更
  needsConfirmation Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([customerId, version])
  @@index([organizationId, createdAt])
  @@index([customerId, createdAt])
  @@map("customer_requirement_snapshots")
}

/// 客户对具体房源的反馈。用于累积"客户为什么喜欢/不喜欢"。
model CustomerPropertyFeedback {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  /// 来源消息
  sourceMessageId String?
  /// 反馈中提到的房源序号（客户说"第一套"时为 1），用于在未匹配到 propertyId 时定位
  mentionedIndex Int?

  sentiment PropertyFeedbackSentiment @default(UNKNOWN)
  /// 兴趣等级 0～5，5 表示非常喜欢
  interestLevel Int?
  /// 客户原话
  rawQuote String? @db.Text
  /// 反馈原因摘要
  reasons String[] @default([])

  /// 各维度的具体反应
  reactions Json @default("[]")

  /// 价格反应说明（如"觉得贵了"）
  priceReaction String?
  locationReaction String?
  layoutReaction String?
  communityReaction String?

  notes String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([customerId, createdAt])
  @@index([propertyId])
  @@index([sourceMessageId])
  @@map("customer_property_feedback")
}

/// 推荐批次。记录"某次给某客户推荐了哪些房源"。
model RecommendationBatch {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agentId        String

  /// 触发本次推荐的消息
  sourceMessageId String?
  /// 使用的需求快照版本
  requirementSnapshotId String?

  /// 贝壳检索到的候选数量
  candidateCount Int @default(0)
  /// 通过硬筛的数量
  hardFilteredCount Int @default(0)
  /// 最终推荐的房源 ID 列表（按推荐顺序）
  recommendedPropertyIds String[] @default([])
  /// 每套房的评分明细（JSON）
  scoreBreakdowns Json @default("[]")

  status RecommendationStatus @default(GENERATED)

  /// 使用的搜索条件（JSON，便于复现）
  searchQuery Json?
  /// 贝壳原始召回数
  beikeTotalRecalled Int?
  /// 全流程耗时
  durationMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 生成该批次的回复
  replies GeneratedCustomerReply[]

  @@index([organizationId, createdAt])
  @@index([customerId, createdAt])
  @@index([agentId, createdAt])
  @@index([status])
  @@map("recommendation_batches")
}

/// 生成的微信回复文案。
///
/// 注意状态语义：
///   copiedAt        —— 经纪人点了"复制"，**不代表客户已收到**
///   sentConfirmedAt —— 经纪人人工确认"我已发送"
/// 系统绝不能自动把状态推进到"已发送"。
model GeneratedCustomerReply {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agentId        String

  recommendationBatchId String?
  recommendationBatch   RecommendationBatch? @relation(fields: [recommendationBatchId], references: [id], onDelete: SetNull)

  /// 回复正文（可直接粘贴到普通微信）
  content String @db.Text
  /// 文案风格
  style ReplyStyle @default(NATURAL_PROFESSIONAL)
  /// 该文案提到的房源 ID
  propertyIds String[] @default([])

  /// 复制时间（人工操作）
  copiedAt DateTime?
  /// 人工确认发送时间
  sentConfirmedAt DateTime?
  /// 是否由 AI 生成（false 表示规则模板降级）
  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([customerId, createdAt])
  @@index([recommendationBatchId])
  @@map("generated_customer_replies")
}
