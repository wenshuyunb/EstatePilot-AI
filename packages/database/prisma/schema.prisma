  title       String
  description String?
  dueAt       DateTime?
  completedAt DateTime?
  /// 由哪条机会生成
  opportunityId String?
  /// 是否由 AI 建议生成
  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([assignedAgentId, status, dueAt])
