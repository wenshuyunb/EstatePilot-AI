// 带看
// ============================================================================

enum ViewingStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ViewingFeedbackLiked {
  LIKE
  DISLIKE
  NEUTRAL
}

enum IntentTrend {
  WARMING
  STABLE
  COOLING
}

model Viewing {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId        String?
  store          Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agentId    String
  agent      User     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  completedAt DateTime?
  status      ViewingStatus @default(PLANNED)

  /// 带看前备注
  notes String?
  /// 带看后反馈原文（可能是语音转写结果）
  feedback String?
  /// 客户总体满意度 1～5
  satisfaction Int?

  /// AI 结构化分析结果（JSON，符合 ViewingAnalysis）
  analysis Json?
  analysisAt DateTime?
  analysisAiGenerated Boolean @default(false)

  /// 客户爽约/取消原因
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties ViewingProperty[]
  voiceNotes VoiceNote[]

  @@index([organizationId, scheduledAt])
  @@index([customerId, scheduledAt])
  @@index([agentId, scheduledAt])
  @@index([organizationId, status, scheduledAt])
  @@index([storeId, scheduledAt])
  @@map("viewings")
}

/// 带看中的单套房源及其反馈
model ViewingProperty {
  id         String   @id @default(cuid())
  viewingId  String
  viewing    Viewing  @relation(fields: [viewingId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// 第几套看的
  visitOrder Int @default(0)
  /// 客户是否喜欢
  liked ViewingFeedbackLiked @default(NEUTRAL)
  /// 优点
  pros String[] @default([])
  /// 缺点/反对点
  cons String[] @default([])
  /// 客户对该套的心理价位（元）
  customerPrice BigInt?
  /// 客户原话
  customerComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([viewingId, propertyId])
  @@index([propertyId])
  @@map("viewing_properties")
}

