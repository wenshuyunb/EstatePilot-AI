// ============================================================================
// AI 模块
// ============================================================================

enum AiProviderKind {
  MOCK
  DEEPSEEK
  OPENAI
  ANTHROPIC
}

enum AiRunStatus {
  SUCCESS
  FAILED
  FALLBACK
}

enum ChatRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

/// AI 助手会话
model AiConversation {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
