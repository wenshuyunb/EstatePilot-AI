enum CommunicationChannel {
  WECHAT
  PHONE
  SMS
  FACE_TO_FACE
  IN_APP
  OTHER
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum CommunicationSource {
  MANUAL
  PASTED_TRANSCRIPT
  VOICE_TRANSCRIBED
  AI_GENERATED
}

enum Sentiment {
  VERY_POSITIVE
  POSITIVE
  NEUTRAL
  NEGATIVE
  VERY_NEGATIVE
}

enum CommunicationIntent {
  PRICE_INQUIRY
  SCHEDULE_VIEWING
  NEGOTIATION
  LOAN_QUESTION
  POLICY_QUESTION
  OBJECTION
  REQUEST_MORE_OPTIONS
  REJECTION
  HESITATION
  SMALL_TALK
  OTHER
}

/// 沟通记录。支持粘贴微信聊天记录后由 AI 分析并更新画像。
model Communication {
  id             String @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agentId        String
  agent          User     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  channel   CommunicationChannel
  direction CommunicationDirection
  source    CommunicationSource @default(MANUAL)

  /// 原始内容
  content String
  /// AI 摘要
  summary String?
  /// AI 判断的客户情绪
  sentiment Sentiment?
  /// AI 判断的沟通意图
  intent CommunicationIntent?

  /// AI 识别出的客户异议点
  objections String[] @default([])
  /// AI 识别出的预算变化（元）
  budgetChange BigInt?
  /// AI 识别出的购房时间线索
  timelineHint String?
  /// AI 识别出的需求变化点
  requirementChanges String[] @default([])
  /// 建议的下一步动作
  nextActions String[] @default([])
  /// 完整 AI 分析结果（JSON，符合 CommunicationAnalysis）
  analysis Json?
  analysisAt DateTime?
  analysisAiGenerated Boolean @default(false)

  /// 是否已用于更新客户画像
  appliedToProfile Boolean @default(false)

  /// 沟通发生时间
  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([agentId, occurredAt])
  @@index([customerId, channel])
  @@map("communications")
}

// ============================================================================
// 语音记录
// ============================================================================

enum VoiceNoteStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  FAILED
}

enum VoiceNoteAnalysisKind {
  VIEWING_FEEDBACK
  COMMUNICATION
}

/// 语音快速记录。第一版以文本模式为主，接口与服务抽象已就绪，
/// 后续接入真实 ASR 只需替换 TranscriptionService 实现。
model VoiceNote {
